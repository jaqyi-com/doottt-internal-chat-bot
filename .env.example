# ---- Neon (read-only use) ----
NEON_DATABASE_URL=postgresql://user:pass@host-pooler/neondb?sslmode=require

# ---- LLM via Google Gemini (OpenAI-compatible endpoint) ----
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# optional overrides
LLM_MODEL_FAST=gemini-flash-lite-latest
LLM_MODEL_SMART=gemini-3.5-flash

# ---- Conversation store ----
# Vercel: Postgres via CHAT_DATABASE_URL (Neon DIRECT/unpooled URL; tables live in schema CHAT_DB_SCHEMA, never "final")
# or Turso. Local dev: leave all empty -> file:./data/chat.db
CHAT_DATABASE_URL=
CHAT_DB_SCHEMA=chatbot
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Access gate (required in production) ----
APP_PASSWORD=
AUTH_SECRET=

# ---- Agent limits ----
AGENT_MAX_ATTEMPTS=3
AGENT_RECURSION_LIMIT=30
LLM_MAX_TOKENS=4000
